class Solution(object):
    def findTheDifference(self, s, t):
        hashmap={}
        for i in range(len(s)):
            if s[i] in hashmap:
                hashmap[s[i]]+=1
            else:
                hashmap[s[i]]=1
        for i in range(len(t)):
            if t[i] in hashmap:
                hashmap[t[i]]-=1
                if hashmap[t[i]]<0:
                    return t[i]
        return t[i]
        
