class Solution(object):
    def wordPattern(self, pattern, s):
        map1={}
        map2={}
        word=s.split()
        if len(pattern)!=len(word):
            return False
        for i in range(len(pattern)):
            c1=pattern[i]
            c2=word[i]
            if c1 in map1:
                if map1[c1]!=c2:
                    return False
            else:
                map1[c1]=c2
            if c2 in map2:
                if map2[c2]!=c1:
                    return False
            else:
                map2[c2]=c1
        return True



        
