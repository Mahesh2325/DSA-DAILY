class Solution(object):
    def canConstruct(self, ransomNote, magazine):
        hashmap={}
        for i in ransomNote:
            if i in hashmap:
                hashmap[i]+=1
            else:
                hashmap[i]=1
        for i in magazine:
            if i in hashmap:
                hashmap[i]-=1
        for i in hashmap:
            if hashmap[i]<=0:
                return True
        return False
